    "/api/discover/top-cross-holders": {
      "get": {
        "tags": [
          "discover"
        ],
        "summary": "Top Cross Holders",
        "description": "High-frequency cross-company individual shareholders.\n\nSource: `holder_companies` (whole-market coverage from teamwork ETL).\n`total_value` is enriched from holdings × latest close when available.",
        "operationId": "top_cross_holders_api_discover_top_cross_holders_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CrossHolder"
                  },
                  "title": "Response Top Cross Holders Api Discover Top Cross Holders Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
