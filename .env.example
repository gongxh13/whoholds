# Copy this to deploy/docker/.env (next to docker-compose.yml) and fill in:
#
#   cp .env.example deploy/docker/.env
#   # generate the hash:
#   docker run --rm caddy:2.8-alpine caddy hash-password
#   # paste it as WHOHOLDS_PASS_HASH below.

WHOHOLDS_USER=team
WHOHOLDS_PASS_HASH=<paste-bcrypt-hash-here>
